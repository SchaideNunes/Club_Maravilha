# ==============================================================================
# CLUB MARAVILHA - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copie este arquivo para .env e preencha com os valores do seu ambiente:
# cp .env.example .env
# ==============================================================================

# --- [APP & ENVIRONMENT] ---
ENVIRONMENT=development
PROJECT_NAME="Club Maravilha - Sistema de Gestão"
DEBUG=true
PORT_BACKEND=8000
PORT_FRONTEND=5173
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
# Agendador da régua de cobrança + worker da fila anti-ban de WhatsApp (rodam dentro da API).
# Deixe ligado em UM único processo; em produção a API sobe com --workers 1.
SCHEDULER_ENABLED=true

# --- [BANCO DE DADOS POSTGRESQL] ---
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=club_maravilha
POSTGRES_USER=club_admin
# OBRIGATÓRIO em produção (docker-compose.prod.yml não sobe sem ele): defina uma senha forte
POSTGRES_PASSWORD=club_secret_password_change_in_prod

# URL de Conexão Assíncrona (usada pelo SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
# URL de Conexão Síncrona (usada pelo Alembic para migrações)
DATABASE_SYNC_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- [SEGURANÇA & JWT AUTH] ---
# Gere uma chave forte (ex: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_very_secure_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- [GATEWAY PIX / WEBHOOKS DE PAGAMENTO] ---
# Provedores suportados: EFI_GERENCIANET | ASAAS | MERCADO_PAGO
PIX_GATEWAY_PROVIDER=EFI_GERENCIANET
PIX_CLIENT_ID=seu_client_id_aqui
PIX_CLIENT_SECRET=seu_client_secret_aqui
PIX_CERTIFICATE_PATH=/app/certs/pix_certificate.pem
# Segredo para validar assinatura de Webhooks recebidos (evita spoofing)
PIX_WEBHOOK_SECRET=segredo_webhook_assinatura_pix_club

# --- [WHATSAPP - AUTOMAÇÃO DE RÉGUA DE COBRANÇA] ---
# Motor próprio (Baileys): microsserviço ./whatsapp-engine consumido pelo backend via HTTP.
# Dentro do docker compose o backend já recebe http://whatsapp-engine:3001; este valor
# vale para rodar o backend fora do Docker.
WHATSAPP_ENGINE_URL=http://localhost:3001
PORT_WHATSAPP_ENGINE=3001
# Chave compartilhada backend <-> motor (header x-api-key).
# OBRIGATÓRIO em produção (docker-compose.prod.yml não sobe sem ela): defina um valor forte.
WHATSAPP_API_KEY=club_maravilha_secret_key_123
# Provedor de envio do backend. MOCK (padrão) apenas registra as mensagens em memória e NÃO envia nada
# (a API avisa no startup quando ENVIRONMENT=production). EVOLUTION_API é legado e só deve ser usado
# de forma explícita. A integração com o motor Baileys chega na Feature 4.
# Um valor desconhecido impede a API de subir.
WHATSAPP_PROVIDER=MOCK
# Legado (Evolution API): usados apenas com WHATSAPP_PROVIDER=EVOLUTION_API
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_INSTANCE_NAME=club_maravilha
# Fila anti-ban: o worker aguarda um tempo aleatório entre MIN e MAX (segundos) após cada envio.
# Reduza só em testes; intervalos curtos aumentam o risco de banimento do número.
WHATSAPP_MIN_DELAY_SECONDS=8
WHATSAPP_MAX_DELAY_SECONDS=20

# --- [INTEGRAÇÃO CATRACA FACIAL] ---
# IP ou hostname da controladora da catraca na rede local
TURNSTILE_HOST=192.168.1.200
TURNSTILE_PORT=80
TURNSTILE_API_TOKEN=token_seguranca_catraca_local
TURNSTILE_TIMEOUT_SECONDS=5

# --- [REGRAS DE NEGÓCIO DO CLUBE] ---
VALOR_MENSALIDADE_PADRAO=150.00
DIA_VENCIMENTO_PADRAO=10
FRANQUIA_CONVITES_MENSAL=8
VALOR_CONVITE_EXCEDENTE=35.00
LIMITE_RESERVAS_SIMULTANEAS_PADRAO=2
